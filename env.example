# env.example — これを .env という名前で写し、自分の環境の値に書き換える（.env は git に入らない）
#   cp env.example .env        （PowerShell: Copy-Item env.example .env）
# 値はすべてダミー。192.0.2.x は説明用に予約されたアドレス（RFC 5737）で、どこにも繋がらない。

# 母艦の中継サーバー（スタックチャン本体が繋がっている WebSocket サーバー）
MIHARI_SERVER_URL=ws://192.0.2.10:8080

# 見回しの角度（サーボの pan。45..135、90 が正面）と、その時の tilt（60..120）
MIHARI_SCAN_PANS=50,70,90,110,130
MIHARI_SCAN_TILT=82

# 首を動かしてから写真を受け取るまで待つ秒（サーバー側の待ち 1.5 秒より少し短くてよい）
MIHARI_SETTLE_S=1.2

# 人物検出のモデル（resnet50 か mobilenet）と、人と見なす確からしさの下限
MIHARI_MODEL=resnet50
MIHARI_MIN_SCORE=0.8
# 推論の装置。既定は cuda。GPU が無い時は明示して cpu を選ぶ（黙って CPU には落ちない）
MIHARI_DEVICE=cuda
# モデルの重みの置き場（初回に自動で取得する。リポジトリの外に置いてもよい）
MIHARI_MODEL_DIR=.models

# 画角の初期値と、pan を増やした時に右を向くなら +1・左なら -1（見回しの写真から自動で測れない時だけ使う）
MIHARI_HFOV_DEG=60
MIHARI_PAN_SIGN=-1

# 暑い・寒いの境目（本体の快適度と同じ既定値）とエアコンの設定温度
MIHARI_HOT_FROM_C=28
MIHARI_COLD_BELOW_C=17
MIHARI_HUMID_FROM=70
MIHARI_COOL_SETPOINT_C=26
MIHARI_HEAT_SETPOINT_C=22

# 赤外線の作り方。raw = 本体に覚えさせたリモコンの信号を名前で送る / ac = メーカーの方式で組み立てる
MIHARI_IR_KIND=raw
MIHARI_IR_RAW_COOL=ac_cool
MIHARI_IR_RAW_HEAT=ac_heat
MIHARI_IR_RAW_DRY=ac_dry
MIHARI_IR_RAW_OFF=ac_off
# kind=ac の時のメーカー名（IRremoteESP8266 の名前。例 DAIKIN）
MIHARI_IR_PROTOCOL=
# 赤外線を送る前に首を向ける pan（エアコンの方向。空なら向きを変えない）
MIHARI_AC_PAN=

# 結果（写真と記録）の置き場。実機の写真には部屋が写るので、リポジトリの外を勧める
MIHARI_OUTPUT_DIR=runs

# 公開前の点検で探す「外に出してはいけない言葉」（氏名・家の名前など。カンマ区切り）
MIHARI_PRIVATE_WORDS=
